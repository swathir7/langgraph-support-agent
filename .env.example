# Optional. Unset: the router uses RuleBasedClassifier (deterministic, offline).
# Set: the router uses LLMClassifier automatically — no other config needed.
OPENAI_API_KEY=
CLASSIFIER_MODEL=gpt-4.1-mini

# Router decisions below this confidence escalate to a human, regardless of route.
ESCALATION_CONFIDENCE_THRESHOLD=0.4

# Resilience tuning for calls to the (mock) order API.
ORDER_RETRY_MAX_ATTEMPTS=3
ORDER_RETRY_BASE_DELAY_SECONDS=0.2
ORDER_CALL_TIMEOUT_SECONDS=5.0
ORDER_CIRCUIT_FAILURE_THRESHOLD=3
ORDER_CIRCUIT_RESET_TIMEOUT_SECONDS=30.0

# Where conversation state persists across restarts.
CHECKPOINT_DB_PATH=support_agent_state.sqlite
